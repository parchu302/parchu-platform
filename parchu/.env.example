# Copiar a .env y completar. NUNCA versionar el .env real.

# --- Base de datos ---
# Desarrollo local: docker compose up -d db (Postgres en el puerto 5433 del host).
DATABASE_URL="postgresql://parchu:parchu_local_dev@localhost:5433/parchu?schema=public"

# Credenciales del contenedor local de Postgres (solo desarrollo).
POSTGRES_USER="parchu"
POSTGRES_PASSWORD="parchu_local_dev"
POSTGRES_DB="parchu"
POSTGRES_PORT="5433"

# --- Secretos de aplicacion ---
# Generar cada uno con: openssl rand -base64 32
# Firma/cifrado de la cookie de sesion (Fase 1).
SESSION_SECRET=""
# Cifrado AES-256-GCM del codigo de confirmacion de pedidos (Fase 5).
# Debe ser una clave de 32 bytes en base64.
CONFIRMATION_CODE_SECRET=""

# --- Cuenta de administrador (solo para `prisma db seed`) ---
# La cuenta admin se crea por base de datos, nunca por la UI.
# Generar la contrasena con: openssl rand -base64 18
ADMIN_EMAIL="admin@parchu.local"
ADMIN_PASSWORD=""
